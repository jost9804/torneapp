generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  FOOTBALL_11
}

enum TournamentFormat {
  ROUND_ROBIN
  ROUND_ROBIN_HOME_AWAY
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum MatchStatus {
  SCHEDULED
  PLAYED
}

/// What a user can do inside one tournament
enum Role {
  ADMIN
  REFEREE
  COACH
  PLAYER
}

/// PENDING: the user asked to join and waits for an admin
enum MembershipStatus {
  PENDING
  ACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CardType {
  YELLOW
  RED
}

/// Roles inside a team (club). OWNER is the creator; up to 2 ADMINs help manage it.
enum ClubRole {
  OWNER
  ADMIN
  COACH
  SPOKESPERSON
  CAPTAIN
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  name            String
  /// scrypt hash; null for accounts created only through Google or Facebook
  passwordHash    String?
  googleId        String?            @unique
  facebookId      String?            @unique
  avatarUrl       String?
  /// Set once the user enters the code sent by email (Google/Facebook count as confirmed)
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  emailCode       EmailCode?
  memberships     Membership[]
  refereeing      Match[]            @relation("MatchReferee")
  playerRequests  PlayerRequest[]
  likes           TournamentLike[]
  follows         TournamentFollow[]
  clubRoles       ClubMember[]
  entryRequests   EntryRequest[]
}

/// The pending email confirmation code; one per user, replaced on every resend
model EmailCode {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HMAC of the 6-digit code, never the code itself
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  sentAt          DateTime @default(now())
  /// Sends in the current hour, to cap resends
  sendsInWindow   Int      @default(1)
  windowStartedAt DateTime @default(now())
}

/// A team that exists on its own and plays many tournaments. Each tournament gets a
/// `Team` entry (its roster, matches and final position) linked back here.
model Club {
  id            String         @id @default(uuid())
  name          String
  crestUrl      String?
  /// The name may change again 6 months after this
  nameChangedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  members       ClubMember[]
  players       ClubPlayer[]
  entries       Team[]
  entryRequests EntryRequest[]

  @@index([name])
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ClubRole
  createdAt DateTime @default(now())

  @@unique([clubId, userId, role])
  @@index([userId])
}

/// The club's usual squad; it is copied into each tournament roster on entry
model ClubPlayer {
  id       String  @id @default(uuid())
  clubId   String
  club     Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name     String
  number   Int?
  position String?
}

/// A club admin asks to enter a tournament; the tournament admin approves or rejects it
model EntryRequest {
  id            String     @id @default(uuid())
  clubId        String
  club          Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User       @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([clubId, tournamentId])
}

model Membership {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  role         Role
  status       MembershipStatus @default(PENDING)
  /// Team a coach manages or a player belongs to
  teamId       String?
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  /// Roster entry a PLAYER membership is linked to, so the player can edit it
  playerId     String?          @unique
  player       Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@unique([userId, tournamentId, role])
  @@index([tournamentId, status])
}

/// A coach's request to add a player; an admin approves it into the roster
model PlayerRequest {
  id            String        @id @default(uuid())
  teamId        String
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User          @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  name          String
  number        Int?
  position      String?
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([teamId, status])
}

model Card {
  id       String   @id @default(uuid())
  matchId  String
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type     CardType
  minute   Int?
}

model TournamentLike {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, tournamentId])
}

model TournamentFollow {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, tournamentId])
}

model Tournament {
  id            String             @id @default(uuid())
  name          String
  sport         Sport              @default(FOOTBALL_11)
  format        TournamentFormat   @default(ROUND_ROBIN)
  status        TournamentStatus   @default(DRAFT)
  rulesPdfPath  String?
  /// Picture chosen by the creator, served from /images
  imageUrl      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  teams         Team[]
  matches       Match[]
  memberships   Membership[]
  likes         TournamentLike[]
  follows       TournamentFollow[]
  entryRequests EntryRequest[]
}

/// A club's entry in one tournament. Name and crest are copied from the club and stop
/// following it once the tournament finishes, so history shows what was played.
model Team {
  id             String          @id @default(uuid())
  name           String
  crestUrl       String?
  clubId         String?
  club           Club?           @relation(fields: [clubId], references: [id], onDelete: SetNull)
  /// Saved when the tournament finishes
  finalPosition  Int?
  tournamentId   String
  tournament     Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players        Player[]
  homeMatches    Match[]         @relation("HomeTeam")
  awayMatches    Match[]         @relation("AwayTeam")
  memberships    Membership[]
  playerRequests PlayerRequest[]

  @@unique([tournamentId, name])
  @@index([clubId])
}

model Player {
  id         String      @id @default(uuid())
  name       String
  number     Int?
  position   String?
  teamId     String
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  goals      Goal[]
  cards      Card[]
  membership Membership?
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  scheduledAt  DateTime?
  homeTeamId   String
  homeTeam     Team        @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId   String
  awayTeam     Team        @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore    Int?
  awayScore    Int?
  status       MatchStatus @default(SCHEDULED)
  refereeId    String?
  referee      User?       @relation("MatchReferee", fields: [refereeId], references: [id], onDelete: SetNull)
  /// Referee's notes on what happened in the match
  observations String?
  goals        Goal[]
  cards        Card[]

  @@index([tournamentId, round])
}

model Goal {
  id       String @id @default(uuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  minute   Int?
}
