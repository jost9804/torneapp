# Base URL of the TorneApp API
# On a physical device use your machine LAN IP, e.g. http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Google sign-in: OAuth client IDs from Google Cloud Console (one per platform)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Facebook sign-in: App ID from Meta for Developers
EXPO_PUBLIC_FACEBOOK_APP_ID=
